# Copy to .env and fill in. Everything is optional: with no settings WatchMe runs in demo mode,
# in memory, with deterministic (non-AI) case summaries.

# --- Server ---
PORT=3000
# Local-only by default because there is no login yet. Do not expose on a network without an auth proxy.
HOST=127.0.0.1
# Name recorded in the audit log for actions taken in the UI
WATCHME_ANALYST=your.name

# --- Data source: demo | splunk | elastic (without DATA_SOURCE: splunk if SPLUNK_URL is set, else elastic if ELASTIC_URL is set) ---
DATA_SOURCE=demo

# --- Splunk (REST API on the management port) ---
# Splunk Free: add "allowRemoteLogin = always" under [general] in server.conf when WatchMe runs on another host.
SPLUNK_URL=https://localhost:8089
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=
# Or use a Splunk auth token instead of username/password (not available on Splunk Free)
SPLUNK_TOKEN=
# Splunk's default certificate is self-signed; set false only for a local lab
SPLUNK_VERIFY_TLS=false
# Index or comma-separated indexes to search, e.g. botsv3
SPLUNK_INDEX=botsv3
SPLUNK_MAX_EVENTS=20000
SPLUNK_TIMEOUT_MS=120000

# --- Elasticsearch (Winlogbeat / ECS data). See docs/ELASTIC_SETUP.md ---
ELASTIC_URL=
ELASTIC_USERNAME=elastic
# Also used by docker-compose.elastic.yml as the password of the elastic user
ELASTIC_PASSWORD=changeme
# Or an API key (base64 "id:key") instead of username/password
ELASTIC_API_KEY=
# Set false only for a self-signed HTTPS lab cluster
ELASTIC_VERIFY_TLS=true
ELASTIC_INDEX=winlogbeat-*
ELASTIC_MAX_EVENTS=50000
# Drop high-volume benign OS/UI process noise (conhost, RuntimeBroker, msedgewebview2...) so the graph focuses on real activity
ELASTIC_DENOISE=true
# Extra process names to drop, comma-separated, e.g. docker.exe,node.exe (added to the built-in noise list)
ELASTIC_EXCLUDE_PROCS=
# Drop events by command line, comma-separated glob patterns ('*' = wildcard, matched anywhere, case-insensitive).
# Targets specific benign commands, so cmd/net/curl/powershell stay for everything else. Disabled by ELASTIC_DENOISE=false.
# Patterns match the RAW command line (full paths, .exe, http://), so join tokens with * rather than spaces.
# e.g. kubectl*--help,wsl*--version,curl*localhost:9200,cmd*kubectl*--help
ELASTIC_EXCLUDE_CMDLINE=
ELASTIC_TIMEOUT_MS=60000
# Used only by docker-compose.elastic.yml
KIBANA_PASSWORD=kibanachangeme
# Address Elasticsearch listens on: 127.0.0.1 (this PC only) or a VirtualBox host-only address for a lab VM (docs/LAB_SETUP.md)
ELASTIC_BIND=127.0.0.1
ELASTIC_VERSION=8.19.13

# End of the investigation window (UTC). Leave empty for "now". BOTS data is historical, e.g.:
# DEFAULT_T0=2018-08-21T00:00:00Z
DEFAULT_T0=
# Days of history before the window used for first-seen detection (0 disables)
BASELINE_DAYS=30
# Also pull host-only events (service installs, scheduled tasks, Defender, registry) from hosts the user logged onto
INCLUDE_HOST_EVENTS=true

# --- Storage: PostgreSQL (cases, audit log, watchlist). Empty = in memory, lost on restart ---
# DATABASE_URL=postgres://watchme:watchme@localhost:5432/watchme
DATABASE_URL=

# --- AI (optional): case summaries and the AI Storyline. Without a provider, both are rule-based ---
# gemini | claude | ollama | none. Empty: auto — gemini if GEMINI_API_KEY is set, else claude if ANTHROPIC_API_KEY is set, else ollama if OLLAMA_URL is set, else none
AI_PROVIDER=
GEMINI_API_KEY=
# Check the model name against Google's current model list
GEMINI_MODEL=gemini-3.8-flash
# Anthropic Claude (cloud). Get a key at console.anthropic.com. Used when AI_PROVIDER=claude, or auto if only this key is set.
ANTHROPIC_API_KEY=
# Check the model name against Anthropic's current model list
CLAUDE_MODEL=claude-sonnet-4-5
# Optional: override the API base (e.g. a gateway/proxy). Default https://api.anthropic.com
ANTHROPIC_BASE_URL=
# Ollama runs models on your own machine: nothing leaves it. Install from ollama.com, then e.g. "ollama pull llama3.1:8b"
OLLAMA_URL=
OLLAMA_MODEL=llama3.1:8b

# --- Inbound alert webhook: callers must send this value in the X-WatchMe-Secret header ---
WEBHOOK_SECRET=
